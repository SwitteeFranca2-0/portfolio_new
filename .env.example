# ── Database (PostgreSQL) ──────────────────────────────────────────────────────
# Works with Railway, Supabase, Neon, or any Postgres provider.
DATABASE_URL="postgresql://user:password@host:5432/dbname"
# Direct (non-pooled) connection string, used for migrations where the
# provider requires bypassing a connection pooler. Can be the same as
# DATABASE_URL if your provider doesn't distinguish between the two.
DIRECT_URL="postgresql://user:password@host:5432/dbname"

# Postgres schema all Prisma models live under. Defaults to "portfolio" if unset.
DB_SCHEMA="portfolio"

# ── File Storage ────────────────────────────────────────────────────────────────
# Three modes, auto-detected from these vars (see lib/s3.ts and
# app/api/admin/upload/route.ts):
#   1. Local (default)      — leave everything below unset. Files go to
#                              public/uploads/, served at /uploads/.
#   2. S3-compatible        — set IS_S3_ENDPOINT=true + the AWS_* / BUCKET_NAME
#                              vars below. Works with AWS S3, Cloudflare R2,
#                              MinIO, DigitalOcean Spaces, Backblaze B2, etc.
#   3. Supabase Storage     — set S3_ENDPOINT to your Supabase storage URL +
#                              JWT_SECRET. Do NOT set IS_S3_ENDPOINT.
#
# Uploaded files are proxied through GET /api/images/[...key], so the bucket
# itself never needs to be publicly readable.

IS_S3_ENDPOINT="true"
S3_ENDPOINT="https://s3.example-region.amazonaws.com"
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"
BUCKET_NAME="your-bucket-name"
REGION="us-east-1"

# Used only for the Supabase Storage REST API mode (signs a short-lived
# service-role JWT for uploads). Leave unset for local or plain S3 mode.
JWT_SECRET="your-supabase-storage-jwt-secret"

# Optional convenience aliases for the configured bucket name — set these if
# other parts of your deployment (e.g. a CDN config) need to read the bucket
# name from the environment too. NEXT_PUBLIC_ variant is exposed client-side.
UPLOAD_BUCKET="your-bucket-name"
NEXT_PUBLIC_UPLOAD_BUCKET="your-bucket-name"

# ── Admin Auth (NextAuth) ──────────────────────────────────────────────────────
# Used to sign/encrypt admin session JWTs. Any long random string works —
# generate one with `openssl rand -base64 32`. This must be a genuinely
# random, long secret — do not reuse a short or guessable value.
NEXTAUTH_SECRET="your-super-secret-value-min-32-chars"

# NextAuth's own env-based "trust this host" convention. Not strictly
# required here — `trustHost: true` is already set explicitly in
# lib/auth.config.ts, which covers Railway (and any host) in production.
# Documented for completeness in case you prefer env-based config instead.
# AUTH_TRUST_HOST="true"

# ── Email (Mailjet, contact form) ────────────────────────────────────────────────
MAIL_API_KEY="your-mailjet-api-key"
MAIL_SECRET_KEY="your-mailjet-secret-key"
